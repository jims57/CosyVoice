   "metadata": {},
   "source": [
    "(save-image)\n",
    "version=\"1.1\" && server_name=\"cosy-tts\" && image_prefix=\"jims57\" && image_name=\"${image_prefix}/${server_name}\" && tag=\"v${version}\" && docker commit --pause=false \"${server_name}\" \"${image_name}:${tag}\"\n",
    "\n",
    "(save-and-push-image)\n",
    "version=\"1.1\" && server_name=\"cosy-tts\" && image_prefix=\"jims57\" && docker commit --pause=false \"${server_name}\" \"${image_name}:${tag}\" && docker push \"${image_name}:${tag}\"\n",
    "\n",
    "(docker pull)\n",
    "version=\"1.1\" && server_name=\"cosy-tts\" && image_prefix=\"jims57\" && docker commit --pause=false \"${server_name}\" \"${image_name}:${tag}\" && docker push \"${image_name}:${tag}\"\n",
    "\n",
    "(start-docker)\n",
    "version=\"1.1\" && server_name=\"cosy-tts\" && image_prefix=\"jims57\" && image_name=\"${image_prefix}/${server_name}\" && tag=\"v${version}\" && docker rm \"${server_name}\" -f && docker run --gpus all -it -p 7860:7860 -p 8080:8080 -p 9000:9000  -p 9001:9001 -p 9002:9002 -p 9003:9003 --shm-size=16g -w /workspace/CosyVoice --name \"${server_name}\" \"${image_name}:${tag}\" /bin/bash -c \"bash /root/.jupyter_startup.sh; /bin/bash\"\n",
    "\n",
    "\n",
    "\n",
    "v1.1.1:\n",
    "    * install ttsfrd\n",
    "    * upload cosy-api.py\n",
    "v1.1:\n",
    "    * install CosyVoice and Jupyter"
   ]
  }
